node_modules/
.next/
out/
build/
.DS_Store
*.pem
.env*
!.env.example
next-env.d.ts
.vercel
*.tsbuildinfo

# Local design inputs — NOT shipped.
# intro.md carries the real-name mapping table in full, so publishing it would
# defeat every abstraction in the app. The mockups are design reference only.
/intro.md
/examples/

# The real-name substitution script. It holds the mapping itself, so committing
# it would publish exactly what every abstraction in this app exists to hide.
/main.py
/replace_names*.py

# Backups the substitution script leaves behind. They hold the ORIGINAL
# abstract names, so their contents are safe — but `git checkout -f` does not
# remove untracked files, so without this they survive the demo teardown and
# the next `git add .` sweeps them in.
*.bak

# Static export output.
/out/

# Extracted design assets that carry the real wordmark, baked into pixels: the
# logo in two of the three sheets, a ship's hull, a laptop header bar, a truck
# trailer, a jacket and a hi-vis vest. `pnpm check:tokens` reads text and
# cannot see inside a PNG, so a leak that arrives as an image passes every
# guard this repository has. The 36 unbranded assets elsewhere under
# /public/assets/ ARE committed.
/public/assets/branded/

# Design input, not the application. Same reason intro.md and examples/ are
# ignored: it is what the site is drawn FROM, and the repository ships the site.
/DESIGN_BRIEF.md
/DESIGN_PROMPT.md
