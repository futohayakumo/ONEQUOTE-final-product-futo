# Local design inputs — NOT shipped.
# intro.md carries the real-name mapping table in full, so publishing it would
# defeat every abstraction in the app. The mockups are design reference only.
/intro.md
/examples/

# The real-name substitution script. It holds the mapping itself, so committing
# it would publish exactly what every abstraction in this app exists to hide.
/main.py
/replace_names*.py

# Backups the substitution script leaves behind. They hold the ORIGINAL
# abstract names, so their contents are safe — but `git checkout -f` does not
# remove untracked files, so without this they survive the demo teardown and
# the next `git add .` sweeps them in.
*.bak
