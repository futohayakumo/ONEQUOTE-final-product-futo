{
  "name": "interactive-logistics-portfolio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:tokens": "bash scripts/check-tokens.sh",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "verify": "pnpm check:tokens && pnpm exec tsc --noEmit && pnpm lint && pnpm test && pnpm build",
    "build:static": "STATIC_EXPORT=1 next build",
    "locales:pull": "node scripts/pull-locales.mjs",
    "locales:check": "node --experimental-strip-types --test src/lib/i18n.test.ts",
    "ports:pull": "node --experimental-strip-types scripts/pull-ports.mts",
    "boot": "bash scripts/up.sh",
    "halt": "bash scripts/down.sh",
    "boot:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/up.ps1",
    "halt:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/halt.ps1"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "clsx": "^2.1.1",
    "maath": "^0.10.8",
    "mermaid": "^11.17.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.9.0"
  }
}
